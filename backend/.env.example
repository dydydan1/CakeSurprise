NODE_ENV=development
PORT=5000
CLIENT_ORIGIN=http://localhost:5173

DB_HOST=localhost
DB_PORT=3306
DB_NAME=cake_qr_surprise
DB_USER=root
DB_PASSWORD=change_me

SESSION_HOURS=8

# In production, CLIENT_ORIGIN must be the HTTPS Vercel URL without a path.
# Railway's generated MySQL variables should be mapped to the DB_* names above.

# Used only by npm run seed:admin. Remove ADMIN_PASSWORD after seeding.
ADMIN_EMAIL=owner@example.com
ADMIN_NAME=Cake Business Owner
ADMIN_PASSWORD=change_to_a_strong_password

